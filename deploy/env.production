#--------------------------------------------------------------------
# Live .env — μετονομάστε σε ".env" και ανεβάστε το στη ρίζα του project
# (δίπλα στα app/, public/, vendor/, writable/ — ΟΧΙ μέσα στο public/).
# Συμπληρώστε όλα τα <...>.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://<domain>/'
# Καθαρά URLs χωρίς index.php (απαιτεί mod_rewrite, το public/.htaccess το καλύπτει)
app.indexPage = ''

#--------------------------------------------------------------------
# Βάση (δημιουργήστε βάση + χρήστη από το panel)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = <db_name>
database.default.username = <db_user>
database.default.password = <db_password>
database.default.DBDriver = MySQLi
database.default.DBPrefix = tickets_
database.default.port = 3306

#--------------------------------------------------------------------
# Installer: ένα τυχαίο κλειδί >= 16 χαρακτήρων.
# Μετά την εγκατάσταση μπορεί να σβηστεί (ο installer κλειδώνει μόνος του).
#--------------------------------------------------------------------
install.token = <random-long-token>

#--------------------------------------------------------------------
# Email (SMTP του hosting ή Gmail app password)
#--------------------------------------------------------------------
email.fromEmail = <noreply@domain>
email.fromName = 'Ticketing System'
email.protocol = smtp
email.SMTPHost = <smtp_host>
email.SMTPUser = <smtp_user>
email.SMTPPass = <smtp_password>
email.SMTPPort = 587
email.SMTPCrypto = tls
email.mailType = html

ADMIN_NOTIFY_EMAIL = <admin@domain>

#--------------------------------------------------------------------
# Cloudflare Turnstile — προσθέστε το live domain στο widget
#--------------------------------------------------------------------
turnstile.siteKey = <site_key>
turnstile.secretKey = <secret_key>

#--------------------------------------------------------------------
# PayPal — για ΔΟΚΙΜΕΣ sandbox. Για πραγματικές πληρωμές:
# live credentials + PAYPAL_BASE_URL = https://api-m.paypal.com
#--------------------------------------------------------------------
paypal.clientId = <sandbox_client_id>
paypal.secret = <sandbox_secret>
PAYPAL_BASE_URL = https://api-m.sandbox.paypal.com
# Webhook: https://<domain>/paypal/webhook (PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.REFUNDED)
paypal.webhookId = <webhook_id>

